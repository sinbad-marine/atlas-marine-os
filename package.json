{
  "name": "sinbad-marine-release-quality",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "academy:gasm-catalog": "node tools/build-academy-gasm-catalog.mjs",
    "academy:exam-local": "node tools/start-academy-exams.js",
    "argos:run:start": "node tools/argos-assurance-ledger.js start",
    "argos:run:finish": "node tools/argos-assurance-ledger.js finish",
    "argos:archive:create": "node tools/argos-encrypted-archive.js create",
    "argos:archive:verify": "node tools/argos-encrypted-archive.js verify",
    "argos:archive:key:init": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/argos-windows-archive.ps1 initialize",
    "argos:archive:local": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/argos-windows-archive.ps1 archive",
    "argos:archive:task:install": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/argos-windows-archive.ps1 install-task",
    "argos:archive:task:status": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/argos-windows-archive.ps1 task-status",
    "health:argos": "node tools/run-argos-health.js",
    "observe:argos": "node tools/argos-repository-observer.js",
    "verify:argos": "node tools/verify-argos-integrity.js",
    "test": "node --test sinbad-ai-core/tests/*.test.js tests/*.test.js",
    "test:web": "playwright test",
    "test:web:update-golden": "playwright test tests/browser/visual-regression.spec.js --update-snapshots",
    "test:web:install": "playwright install chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "mammoth": "1.12.1",
    "tesseract.js": "5.1.1"
  }
}
