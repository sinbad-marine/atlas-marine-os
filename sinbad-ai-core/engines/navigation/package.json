{
  "name": "sinbad-navigation-engine",
  "version": "0.2.0",
  "private": true,
  "description": "Testable maritime navigation mathematics engine extracted from the Sinbad audit snapshot.",
  "main": "src/index.js",
  "exports": "./src/index.js",
  "type": "commonjs",
  "files": [
    "src/",
    "docs/",
    "validation/",
    "examples/",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "UNLICENSED",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:navigation": "node --test tests/sinbad-navigation.test.js",
    "check:example": "node examples/basic-route.js",
    "audit:release": "node scripts/release-audit.js",
    "verify": "npm run audit:release && npm test && npm run check:example"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "geographiclib-geodesic": "2.2.0"
  }
}
